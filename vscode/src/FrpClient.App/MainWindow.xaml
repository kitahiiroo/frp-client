<Window x:Class="FrpClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FrpClient.App.Views"
        mc:Ignorable="d"
        Title="端口转发管理"
        Icon="Assets/frpclient.ico"
        Height="760"
        Width="1120"
        MinHeight="680"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FC">
    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelCard}"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="服务控制"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0"
                                Padding="9,3"
                                Background="#EFF6FF"
                                BorderBrush="#D5E3F8"
                                BorderThickness="1"
                                CornerRadius="10"
                                VerticalAlignment="Center">
                            <TextBlock Name="FrpcVersionTextBlock"
                                       Text="frpc -"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Name="ConfigStatusTextBlock"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Name="OpenFrpFolderButton"
                            Width="112"
                            Margin="0,0,8,0"
                            Content="打开目录"
                            Click="OpenFrpFolderButton_Click" />
                    <Button Name="StartButton"
                            Width="112"
                            Margin="0,0,8,0"
                            Content="启动服务"
                            Background="{StaticResource SuccessBrush}"
                            BorderBrush="{StaticResource SuccessBrush}"
                            Foreground="#FFFFFF"
                            Click="StartButton_Click" />
                    <Button Name="StopButton"
                            Width="112"
                            Content="停止服务"
                            IsEnabled="False"
                            Click="StopButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelCard}"
                Margin="0,12,0,14"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="当前配置"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <ComboBox Name="ProfileComboBox"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="{Binding SelectedItem.Name, ElementName=ProfileComboBox}"
                              SelectionChanged="ProfileComboBox_SelectionChanged" />
                    <Button Name="RefreshProfileButton"
                            Grid.Column="2"
                            Width="64"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="刷新"
                            ToolTip="重新读取当前配置的 frpc.toml"
                            Click="RefreshProfileButton_Click" />
                    <Button Name="NewProfileButton"
                            Grid.Column="3"
                            Width="64"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="新建"
                            ToolTip="新建一个空配置方案"
                            Click="NewProfileButton_Click" />
                    <Button Name="DuplicateProfileButton"
                            Grid.Column="4"
                            Width="64"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="复制"
                            ToolTip="复制当前配置方案"
                            Click="DuplicateProfileButton_Click" />
                    <Button Name="RenameProfileButton"
                            Grid.Column="5"
                            Width="64"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="重命名"
                            ToolTip="重命名当前配置"
                            Click="RenameProfileButton_Click" />
                    <Button Name="DeleteProfileButton"
                            Grid.Column="6"
                            Width="64"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="删除"
                            ToolTip="删除当前配置（会同时删除它的 frpc.toml）"
                            Foreground="{StaticResource DangerBrush}"
                            Click="DeleteProfileButton_Click" />
                    <TextBlock Grid.Column="8"
                               Text="状态"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Name="StatusTextBlock"
                               Grid.Column="9"
                               Margin="8,0,0,0"
                               Text="未运行"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource DangerBrush}" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="服务器"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Height="30"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock Name="OverviewServerTextBlock"
                                   Text="-"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Name="CopyServerIpButton"
                            Grid.Column="2"
                            Width="82"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="复制 IP"
                            IsEnabled="False"
                            Click="CopyServerIpButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <TabControl Name="MainTabControl"
                    Grid.Row="2"
                    SelectedIndex="0"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="概览">
                <views:OverviewView x:Name="OverviewView" />
            </TabItem>

            <TabItem Header="配置">
                <views:ConfigurationView x:Name="ConfigurationView" />
            </TabItem>

            <TabItem Header="下载">
                <views:DownloadView x:Name="DownloadView" />
            </TabItem>

            <TabItem Header="日志">
                <views:LogView x:Name="LogView" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
