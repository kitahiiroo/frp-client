<Window x:Class="FrpClient.App.Views.FirewallAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="允许 frpc 通过防火墙"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FC">
    <StackPanel Margin="24">
        <TextBlock Text="选择允许 frpc 访问的网络"
                   Style="{StaticResource SectionTitle}" />
        <TextBlock Name="CurrentNetworkTextBlock"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource PrimaryBrush}" />
        <TextBlock Text="只为当前 frpc 添加 TCP/UDP 入站允许规则；以后更新 frpc 会继续使用同一路径。"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap" />

        <Border Style="{StaticResource PanelCard}" Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <CheckBox Name="PrivateNetworkCheckBox"
                          Content="专用网络（家庭、可信任的工作网络）"
                          IsChecked="True"
                          Checked="NetworkSelectionChanged"
                          Unchecked="NetworkSelectionChanged" />
                <CheckBox Name="PublicNetworkCheckBox"
                          Content="公用网络（按当前网络需要手动勾选）"
                          Margin="0,14,0,0"
                          Checked="NetworkSelectionChanged"
                          Unchecked="NetworkSelectionChanged" />
                <CheckBox Name="DomainNetworkCheckBox"
                          Content="域网络（可能受到组织策略管理）"
                          Margin="0,14,0,0"
                          Checked="NetworkSelectionChanged"
                          Unchecked="NetworkSelectionChanged" />
            </StackPanel>
        </Border>

        <TextBlock Name="SelectionHintTextBlock"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}" />
        <TextBlock Text="若此前在系统弹窗中拒绝访问，会同时清理该 frpc 在所选网络中的旧阻止规则。Windows 将请求一次管理员授权。"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12" />
        <TextBlock Name="ProgramPathTextBlock"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="90" Margin="0,0,10,0" IsCancel="True" />
            <Button Name="ApplyButton"
                    Content="确认并请求管理员授权"
                    Width="210"
                    IsDefault="True"
                    Background="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    Click="ApplyButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
