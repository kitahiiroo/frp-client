<UserControl x:Class="FrpClient.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FrpClient.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="ProxyCardTemplate">
            <Border MinHeight="156"
                    Padding="14"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="1"
                          Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CardLeftLabel}"
                                       Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding CardLeftValue}"
                                       Margin="0,4,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CardLeftValue}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="→"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="27"
                                   Foreground="{StaticResource PrimaryBrush}" />

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CardRightLabel}"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding CardRightValue}"
                                       Margin="0,4,0,0"
                                       FontSize="{Binding CardRightValueFontSize}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CardRightValue}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Border Padding="10,4"
                                HorizontalAlignment="Left"
                                CornerRadius="12"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="udp">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="stcp">
                                            <Setter Property="Background" Value="#F5F3FF" />
                                            <Setter Property="BorderBrush" Value="#DDD6FE" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Type}"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="udp">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="stcp">
                                                <Setter Property="Foreground" Value="#7C3AED" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Button Width="92"
                                Height="28"
                                Padding="10,0"
                                HorizontalAlignment="Right"
                                Content="复制地址"
                                IsEnabled="{Binding CanCopyEndpoint}"
                                Tag="{Binding}"
                                Click="CopyProxyServerEndpointButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Columns="2"
                     Margin="0,0,0,14">
            <Border Style="{StaticResource PanelCard}"
                    Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="运行状态"
                               Style="{StaticResource MutedText}" />
                    <TextBlock Name="OverviewStatusTextBlock"
                               Text="未运行"
                               Margin="0,8,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}"
                    Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="转发规则"
                               Style="{StaticResource MutedText}" />
                    <TextBlock Name="OverviewProxyCountTextBlock"
                               Text="0 条"
                               Margin="0,8,0,0"
                               FontSize="22"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1"
                Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="当前转发规则"
                           Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,12" />

                <Grid Grid.Row="1">
                    <TextBlock Name="OverviewEmptyTextBlock"
                               Text="暂无端口转发规则"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />

                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Name="OverviewProxyItemsControl"
                                      ItemTemplate="{StaticResource ProxyCardTemplate}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveWrapPanel MinItemWidth="260"
                                                                  ItemHeight="156"
                                                                  HorizontalSpacing="14"
                                                                  VerticalSpacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
