<UserControl x:Class="FrpClient.App.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="当前客户端版本"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock Name="CurrentFrpcVersionTextBlock"
                                   Text="-"
                                   Margin="0,7,0,0"
                                   FontSize="21"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="系统架构"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,6" />
                        <ComboBox Name="ArchitectureFilterComboBox"
                                  SelectionChanged="ArchitectureFilterComboBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="14,0,18,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="搜索版本"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,6" />
                        <TextBox Name="SearchReleaseTextBox"
                                 TextChanged="SearchReleaseTextBox_TextChanged" />
                    </StackPanel>

                    <Button Name="RefreshReleasesButton"
                            Grid.Column="3"
                            Width="112"
                            VerticalAlignment="Bottom"
                            Content="刷新列表"
                            Click="RefreshReleasesButton_Click" />
                </Grid>

                <Grid Name="DownloadProgressGrid"
                      Grid.Row="1"
                      Margin="0,14,0,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Name="DownloadProgressTrackBorder"
                            Height="10"
                            Background="#E8EEF7"
                            CornerRadius="5"
                            VerticalAlignment="Center"
                            SizeChanged="DownloadProgressTrackBorder_SizeChanged">
                        <Grid>
                            <Border Name="DownloadProgressFillBorder"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="5" />
                        </Grid>
                    </Border>
                    <TextBlock Name="DownloadProgressTextBlock"
                               Grid.Column="1"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="FirewallStatusTextBlock"
                               Text="Windows 提示防火墙阻止部分功能时，可在此允许 frpc 通过指定网络。"
                               Margin="0,0,16,0"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12" />
                    <Button Name="ConfigureFirewallButton"
                            Grid.Column="1"
                            Width="128"
                            Content="设置防火墙"
                            Click="ConfigureFirewallButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelCard}"
                Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="GitHub Releases"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                    <TextBlock Name="ReleaseStatusTextBlock"
                               Grid.Column="1"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock Name="ReleaseEmptyTextBlock"
                               Text="暂无可下载版本"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />

                    <Border BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="{StaticResource SurfaceBrush}">
                        <DataGrid Name="ReleaseDataGrid"
                                  AlternationCount="2"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="130" />
                                <DataGridTextColumn Header="系统架构" Binding="{Binding PlatformArchitecture}" Width="140" />
                                <DataGridTextColumn Header="发布时间" Binding="{Binding PublishedAtText}" Width="130" />
                                <DataGridTextColumn Header="文件" Binding="{Binding AssetName}" Width="*" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" />
                                <DataGridTemplateColumn Header="操作" Width="116">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="88"
                                                    Height="32"
                                                    Content="{Binding ActionText}"
                                                    ToolTip="{Binding ActionHint}"
                                                    Click="DownloadReleaseButton_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
