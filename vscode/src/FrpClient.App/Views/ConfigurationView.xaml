<UserControl x:Class="FrpClient.App.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*" />
            <ColumnDefinition Width="1.05*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：服务器配置（固定高度）+ 新增/编辑规则（铺满剩余高度） -->
        <Grid Grid.Column="0"
              Margin="0,0,7,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelCard}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="服务器配置"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8" />

                    <Grid Grid.Row="1"
                          Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="服务器 IP"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,0,0,6" />
                            <TextBox Name="ServerAddrTextBox"
                                     Height="36" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="服务器端口"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,0,0,6" />
                            <TextBox Name="ServerPortTextBox"
                                     Height="36" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="权限 token"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,0,0,6" />
                        <TextBox Name="AuthTokenTextBox"
                                 Height="36" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource PanelCard}"
                    Padding="12"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="RuleFormTitleTextBlock"
                                   Text="新增转发规则"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <Button Name="CancelEditButton"
                                Grid.Column="1"
                                Width="84"
                                Height="34"
                                Padding="10,0"
                                Margin="0,0,8,0"
                                Content="取消编辑"
                                Visibility="Collapsed"
                                Click="CancelEditButton_Click" />

                        <Button Name="AddProxyButton"
                                Grid.Column="2"
                                Width="96"
                                Height="34"
                                Padding="12,0"
                                Content="添加转发"
                                Background="{StaticResource SuccessBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                Foreground="#FFFFFF"
                                Click="AddProxyButton_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="名称"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <TextBox Name="ProxyNameTextBox"
                                             Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="类型"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <ComboBox Name="ProxyTypeComboBox"
                                              Height="36"
                                              SelectedIndex="0"
                                              SelectionChanged="ProxyTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="tcp" Tag="tcp" />
                                        <ComboBoxItem Content="udp" Tag="udp" />
                                        <ComboBoxItem Content="stcp 服务端" Tag="stcp-proxy" />
                                        <ComboBoxItem Content="stcp 访问端" Tag="stcp-visitor" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Name="ProxyFieldsPanel"
                                  Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="本地 IP"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <TextBox Name="LocalIpTextBox"
                                             Height="36"
                                             Text="127.0.0.1" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="本地端口"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <TextBox Name="LocalPortTextBox"
                                             Height="36" />
                                </StackPanel>

                                <StackPanel Name="RemotePortPanel"
                                            Grid.Column="2">
                                    <TextBlock Text="服务器端口"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <TextBox Name="RemotePortTextBox"
                                             Height="36" />
                                </StackPanel>

                                <StackPanel Name="StcpSecretPanel"
                                            Grid.Column="2"
                                            Visibility="Collapsed"
                                            ToolTip="STCP 服务端与访问端的密钥必须完全一致。">
                                    <TextBlock Text="密钥（secretKey）"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <TextBox Name="SecretKeyTextBox"
                                             Height="36" />
                                </StackPanel>
                            </Grid>

                            <Grid Name="StcpVisitorFieldsPanel"
                                  Margin="0,8,0,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="服务器名称"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6"
                                               ToolTip="填服务端 stcp 规则的“名称”，不是服务器 IP。" />
                                    <TextBox Name="ServerNameTextBox"
                                             Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="监听地址"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <TextBox Name="BindAddrTextBox"
                                             Height="36"
                                             Text="127.0.0.1" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="监听端口"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6"
                                               ToolTip="bindPort：访问端在本机监听的端口。" />
                                    <TextBox Name="BindPortTextBox"
                                             Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            ToolTip="STCP 服务端与访问端的密钥必须完全一致。">
                                    <TextBlock Text="密钥（secretKey）"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                    <TextBox Name="VisitorSecretKeyTextBox"
                                             Height="36" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Name="FormHintTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 右侧：规则清单（表格可横向、纵向滚动） -->
        <Border Grid.Column="1"
                Style="{StaticResource PanelCard}"
                Padding="14"
                Margin="7,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="转发规则清单"
                               Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />

                    <Border Name="CapabilityChip"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="8,3"
                            Background="#F0FDF4"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="10"
                            VerticalAlignment="Center">
                        <TextBlock Name="CapabilityStatusTextBlock"
                                   Text="STCP 状态未知"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Button Name="DetectVersionButton"
                            Grid.Column="2"
                            Height="30"
                            MinWidth="84"
                            Padding="10,0"
                            Margin="8,0,0,0"
                            Content="检测版本"
                            ToolTip="重新检测当前 frpc 的版本，以及是否支持 STCP"
                            Click="DetectVersionButton_Click" />
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Width="100"
                            Height="34"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Content="编辑选中"
                            Click="EditSelectedButton_Click" />
                    <Button Grid.Column="2"
                            Width="108"
                            Height="34"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Content="删除选中"
                            Foreground="{StaticResource DangerBrush}"
                            Click="DeleteSelectedButton_Click" />
                    <Button Grid.Column="3"
                            Width="108"
                            Height="34"
                            Padding="10,0"
                            Content="保存配置"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Foreground="#FFFFFF"
                            Click="SaveConfigButton_Click" />
                </Grid>

                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Background="{StaticResource SurfaceBrush}">
                    <DataGrid Name="ProxyDataGrid"
                              AlternationCount="2"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Name}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="95" />
                            <DataGridTextColumn Header="本地地址" Binding="{Binding LocalEndpointText}" Width="125" />
                            <DataGridTextColumn Width="70" Binding="{Binding PortText}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="端口"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               ToolTip="tcp/udp 显示服务器端口；stcp 访问端显示监听端口（bindPort）；stcp 服务端没有端口。" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="服务器名称" Binding="{Binding ServerNameText}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding ServerNameText}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
